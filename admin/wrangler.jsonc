{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mallanet-platform-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Isolated clone: staging is workers.dev only. Do not add `routes`.
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "EMERGENCY_API",
      "service": "mallanet-platform-api",
    },
  ],
  // Isolated clone: no Colombia custom domain. Do not add `routes`.
  //
  // NO declarar `routes` aquí: con `routes`, wrangler llama además a
  // /zones/{id}/workers/routes, para lo que el token de cuenta no tiene
  // permiso, y el fallo aborta el deploy DESPUÉS de subir el código y ANTES de
  // promover la versión (el Worker se queda sirviendo la build anterior).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
  },
  // El BFF solo necesita saber dónde vive la API; no hay secretos de runtime
  // (la sesión es el JWT del backend en cookie httpOnly, firmado por la API).
  "vars": {
    "EMERGENCY_API_URL": "https://mallanet-platform-api.e-muth-martinez.workers.dev",
  },
  // Staging: Worker aparte, dominio aparte (admin-staging), API de staging.
  // Mismo fichero a propósito — ver frontend/wrangler.jsonc.
  "env": {
    "staging": {
      "name": "mallanet-platform-admin-staging",
      "workers_dev": true,
      "preview_urls": false,
      "compatibility_date": "2026-08-01",
      "compatibility_flags": ["nodejs_compat"],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
      },
      "services": [
        {
          "binding": "EMERGENCY_API",
          "service": "mallanet-platform-api-staging",
        },
      ],
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
      },
      "vars": {
        "EMERGENCY_API_URL": "https://mallanet-platform-api-staging.e-muth-martinez.workers.dev",
      },
    },
  },
}
