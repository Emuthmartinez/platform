{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mallanet-platform-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Isolated clone: staging is workers.dev only. Do not add `routes`.
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Los dominios propios (apex + www) YA estan adjuntados al Worker; se
  // gestionan por la API de cuenta (/accounts/{id}/workers/domains).
  //
  // NO declararlos aqui: con `routes`, wrangler llama ademas a
  // /zones/{id}/workers/routes, para lo que el token de cuenta no tiene
  // permiso. Ese fallo aborta el deploy DESPUES de subir el codigo pero ANTES
  // de promover la version — el Worker se queda sirviendo la anterior y parece
  // que el despliegue "no hizo nada". Paso de verdad: la primera build sin la
  // site key de Turnstile siguio viva y el formulario no podia enviarse.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  },
  // Entorno de staging: Worker aparte, dominio aparte, base de datos aparte
  // (rama de Neon). Se despliega con `wrangler deploy --env staging`.
  //
  // Comparte este mismo fichero a proposito: si staging y produccion se
  // configuran en sitios distintos, dejan de parecerse, y un entorno de pruebas
  // que no se parece a produccion no prueba nada.
  "env": {
    "staging": {
      "name": "mallanet-platform-web-staging",
      "workers_dev": true,
      "preview_urls": false,
      "compatibility_date": "2026-08-01",
      "compatibility_flags": ["nodejs_compat"],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
      }
    }
  }
}
