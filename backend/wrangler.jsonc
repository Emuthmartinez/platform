{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terremotocolombia-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat da los builtins de Node (http, crypto, buffer, stream) que
  // necesitan Express, helmet, pg y jsonwebtoken.
  "compatibility_flags": ["nodejs_compat"],
  // KTD7: disable *.workers.dev so unknown hostnames cannot reach the API.
  // Do not add `routes` — custom domains attach through the account API.
  // Repeat under env.staging: named environments do not inherit this key.
  "workers_dev": false,
  // El dominio propio (api.terremotocolombia.co) se adjunta por la API de
  // cuenta (/accounts/{id}/workers/domains), NO aqui.
  //
  // Motivo: al declarar `routes`, wrangler llama tambien a
  // /zones/{id}/workers/routes, y el token de cuenta no tiene permiso de zona
  // (403). El token con permiso de zona, a su vez, no puede desplegar Workers.
  // Ninguno de los dos puede hacer el deploy completo, asi que el dominio se
  // adjunta aparte. Ver docs/cloudflare-cutover.md.
  // Config NO secreta (versionada a proposito). Los secretos van por
  // `wrangler secret bulk` desde Doppler, nunca aqui.
  // Cron Triggers. Las expresiones son la FUENTE DE VERDAD en
  // src/services/cron-jobs.ts (CRON_EARTHQUAKES / CRON_GEOCODE /
  // CRON_PERSON_RECONCILE) y aqui se declaran identicas;
  // test/cron-jobs.test.ts compara las dos listas para que editar una sin la
  // otra rompa el build en vez de dejar un cron que no ejecuta nada.
  //
  // - "*/5 * * * *"    sismos. Cada 5 minutos: el feed del USGS se refresca
  //   cada minuto, pero el evento ya paso y los replicas entran con holgura;
  //   cada minuto solo multiplica invocaciones sin ganar frescura util.
  // - "2-59/5 * * * *" geocode. Misma cadencia, DESFASADA dos minutos:
  //   controller.cron es lo unico que distingue un trigger de otro, asi que dos
  //   expresiones iguales serian indistinguibles, y el desfase evita que las
  //   dos tareas compitan por el mismo presupuesto de invocacion.
  // - "4-59/5 * * * *" reconciliacion de PRNs (U7, KTD8). Misma cadencia,
  //   DESFASADA dos minutos mas que geocode (cuatro que sismos), por el mismo
  //   motivo de arriba.
  //
  // A nivel superior a proposito: `triggers` se HEREDA en env.staging, asi que
  // los dos entornos sincronizan sin duplicar configuracion.
  "triggers": {
    "crons": ["*/5 * * * *", "2-59/5 * * * *", "4-59/5 * * * *"]
  },
  // Shared per-colocation flood ceiling. Route middleware keeps its stricter
  // declared limit; this binding prevents isolate multiplication from turning
  // into an unbounded bypass when Valkey is unavailable.
  "ratelimits": [
    {
      "name": "EDGE_RATE_LIMITER",
      "namespace_id": "2026081201",
      "simple": { "limit": 240, "period": 60 }
    }
  ],
  // Cloudflare Queues (U2/U3 del plan de port de colas). El productor es el
  // seam de despacho (src/lib/job-dispatch.ts) via el binding NEEDS_QUEUE; el
  // consumidor es el handler `queue` de src/worker.ts, en este MISMO Worker.
  //
  // Reintentos deliberados, no defaults (plan U2): un fallo de publicacion
  // suele ser una caida del tercero, que quiere reintentos ESPACIADOS
  // (5 x 60 s), no tres seguidos. Agotados los reintentos, el mensaje pasa al
  // DLQ, cuyo consumidor lo persiste en audit_log (accion queue.dead_letter)
  // — la retencion del DLQ es de 4 dias y sin consumidor se PIERDE (KTD4).
  //
  // OJO: `queues` NO se hereda en env.staging (los nombres difieren por
  // entorno); cada bloque declara los suyos.
  //
  // terremotocolombia-matcher (U8): un mensaje `{ prn }` por registro
  // recién estampado/editado — dispara la generación de candidatos
  // deterministas. max_batch_size 10 (mensajes livianos, no hay motivo para
  // procesar de a uno como imports) y mismos retries/retry_delay que imports
  // (3 x 30s, un fallo aquí suele ser la DB, no un tercero externo lento).
  "queues": {
    "producers": [
      { "binding": "NEEDS_QUEUE", "queue": "terremotocolombia-needs" },
      { "binding": "IMPORTS_QUEUE", "queue": "terremotocolombia-imports" },
      { "binding": "MATCHER_QUEUE", "queue": "terremotocolombia-matcher" }
    ],
    "consumers": [
      {
        "queue": "terremotocolombia-needs",
        "max_retries": 5,
        "retry_delay": 60,
        "max_batch_size": 5,
        "dead_letter_queue": "terremotocolombia-needs-dlq"
      },
      { "queue": "terremotocolombia-needs-dlq", "max_retries": 0 },
      // Importación de pacientes: lotes pesados → un mensaje por invocación
      // (max_batch_size 1). Reintentos como el BullMQ previo (3, espaciados).
      {
        "queue": "terremotocolombia-imports",
        "max_retries": 3,
        "retry_delay": 30,
        "max_batch_size": 1,
        "dead_letter_queue": "terremotocolombia-imports-dlq"
      },
      { "queue": "terremotocolombia-imports-dlq", "max_retries": 0 },
      {
        "queue": "terremotocolombia-matcher",
        "max_retries": 3,
        "retry_delay": 30,
        "max_batch_size": 10,
        "dead_letter_queue": "terremotocolombia-matcher-dlq"
      },
      { "queue": "terremotocolombia-matcher-dlq", "max_retries": 0 }
    ]
  },
  "vars": {
    // Bounding box de Colombia para el catalogo de sismos del USGS.
    // getBbox() LANZA si falta cualquiera de las cuatro, asi que sin esto el
    // sync no puede correr. Incluye San Andres (~12.5N, -81.7) y las zonas
    // fronterizas cuyos sismos si se sienten en Colombia.
    "EARTHQUAKES_MIN_LAT": "-5",
    "EARTHQUAKES_MAX_LAT": "14",
    "EARTHQUAKES_MIN_LNG": "-82",
    "EARTHQUAKES_MAX_LNG": "-66",
    "NODE_ENV": "production",
    "COOKIE_SECURE": "true",
    "APP_BASE_URL": "https://terremotocolombia.co",
    "ADMIN_BASE_URL": "https://admin.terremotocolombia.co",
    "CORS_ORIGINS": "https://terremotocolombia.co,https://www.terremotocolombia.co",
    "ENABLE_STRIPE_DONATIONS": "true",
    // Detras de Cloudflare la unica cabecera de IP no falsificable es esta.
    // X-Forwarded-For la puede poner el cliente.
    "TRUSTED_IP_HEADER": "cf-connecting-ip"
  },
  // El esquema compartido (../infra/db/schema.ts) vive FUERA de backend/, asi
  // que esbuild busca sus imports en infra/node_modules y no los encuentra.
  // Es el mismo motivo por el que tsconfig.json ya tiene "paths" para tsc.
  "alias": {
    "drizzle-orm": "./node_modules/drizzle-orm",
    "drizzle-orm/pg-core": "./node_modules/drizzle-orm/pg-core",
    // swagger-ui-express usa __dirname para servir sus assets desde disco, y en
    // Workers no existe: el import tumbaba el arranque entero (toda la API a
    // 1101, no solo /api/docs). Ver src/shims/swagger-ui-express.ts.
    "swagger-ui-express": "./src/shims/swagger-ui-express.ts"
  },
  // Entorno de staging: Worker aparte, dominio aparte, y sobre todo BASE DE
  // DATOS aparte (rama `staging` de Neon, via DATABASE_URL del config `stg` de
  // Doppler). Es lo que permite crear reportes de prueba sin tocar el registro
  // real de personas desaparecidas.
  //
  // Sin binding de Hyperdrive a proposito: en Workers el driver es el HTTP de
  // Neon y el binding no se usa (ver src/worker.ts).
  "env": {
    "staging": {
      "name": "terremotocolombia-api-staging",
      "workers_dev": false,
      "ratelimits": [
        {
          "name": "EDGE_RATE_LIMITER",
          "namespace_id": "2026081202",
          "simple": { "limit": 240, "period": 60 }
        }
      ],
      // Colas de staging: mismos parametros que produccion (un staging que no
      // se parece a produccion no prueba nada), nombres con sufijo -staging.
      "queues": {
        "producers": [
          { "binding": "NEEDS_QUEUE", "queue": "terremotocolombia-needs-staging" },
          { "binding": "IMPORTS_QUEUE", "queue": "terremotocolombia-imports-staging" },
          { "binding": "MATCHER_QUEUE", "queue": "terremotocolombia-matcher-staging" }
        ],
        "consumers": [
          {
            "queue": "terremotocolombia-needs-staging",
            "max_retries": 5,
            "retry_delay": 60,
            "max_batch_size": 5,
            "dead_letter_queue": "terremotocolombia-needs-dlq-staging"
          },
          { "queue": "terremotocolombia-needs-dlq-staging", "max_retries": 0 },
          {
            "queue": "terremotocolombia-imports-staging",
            "max_retries": 3,
            "retry_delay": 30,
            "max_batch_size": 1,
            "dead_letter_queue": "terremotocolombia-imports-dlq-staging"
          },
          { "queue": "terremotocolombia-imports-dlq-staging", "max_retries": 0 },
          {
            "queue": "terremotocolombia-matcher-staging",
            "max_retries": 3,
            "retry_delay": 30,
            "max_batch_size": 10,
            "dead_letter_queue": "terremotocolombia-matcher-dlq-staging"
          },
          { "queue": "terremotocolombia-matcher-dlq-staging", "max_retries": 0 }
        ]
      },
      "vars": {
        "EARTHQUAKES_MIN_LAT": "-5",
        "EARTHQUAKES_MAX_LAT": "14",
        "EARTHQUAKES_MIN_LNG": "-82",
        "EARTHQUAKES_MAX_LNG": "-66",
        "NODE_ENV": "production",
        "COOKIE_SECURE": "true",
        "APP_BASE_URL": "https://staging.terremotocolombia.co",
        "ADMIN_BASE_URL": "https://admin-staging.terremotocolombia.co",
        "CORS_ORIGINS": "https://staging.terremotocolombia.co",
        "TRUSTED_IP_HEADER": "cf-connecting-ip",
        "ENABLE_STRIPE_DONATIONS": "true"
      },
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
      }
    }
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  }
}
