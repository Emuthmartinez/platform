{
  "name": "mallanet-ops",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24" },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy:staging": "opennextjs-cloudflare build && wrangler deploy --env staging"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.29.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "wrangler": "^4.120.1"
  }
}
